    "test": "node --test \"test/**/*.test.js\"",
    "test:poc": "node scripts/poc_live_cittamobi.js",
    "test:bff": "node scripts/test_bff_server.js"
  },
  "keywords": [
    "cittamobi",
    "transit",
    "reverse-engineering",
    "protobuf",
    "realtime",
    "gtfs",
    "ad-free"
  ],
